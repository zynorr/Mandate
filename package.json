{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "description": "BOT Chain agent authorization and transaction evidence ledger",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mandate/web",
    "build": "npm run build --workspace @mandate/web",
    "start": "npm run start --workspace @mandate/web",
    "lint": "npm run lint --workspace @mandate/web",
    "typecheck": "npm run typecheck --workspace @mandate/chain && npm run typecheck --workspace @mandate/web",
    "test": "npm run test --workspace @mandate/chain",
    "check": "npm run typecheck && npm run test && npm run lint && npm run contracts:compile",
    "contracts:compile": "node contracts/compile.mjs",
    "contracts:deploy": "npm run contracts:compile && node contracts/deploy.mjs",
    "contracts:deploy:mainnet": "npm run contracts:compile && node contracts/deploy.mjs",
    "contracts:test": "node --test contracts/networks.test.mjs",
    "contracts:anchor": "node contracts/anchor.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "solc": "^0.8.37"
  }
}

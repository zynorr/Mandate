# Optional overrides. Copy to apps/web/.env.local to change them.
# BOT_CHAIN_ID selects the network: 677 mainnet, 968 Bohr testnet.
# Any other chain ID is rejected.
BOT_CHAIN_ID=677
BOT_RPC_URL=https://rpc.botchain.ai
BOT_BUNDLER_URL=https://bundler.botchain.ai/rpc/
BOT_EXPLORER_URL=https://scan.botchain.ai
BOT_EXPLORER_API_URL=https://scan.botchain.ai/api/v2
BOT_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Testnet values (use with BOT_CHAIN_ID=968):
# BOT_RPC_URL=https://rpc.bohr.life
# BOT_BUNDLER_URL=https://bundler.bohr.life/rpc/
# BOT_EXPLORER_URL=https://scan.bohr.life
# BOT_EXPLORER_API_URL=https://scan.bohr.life/api/v2
# BOT_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Optional read-only anchor registry. Remove this line to disable anchor checks.
# Mainnet registry: 0xc69367d69b12bc14397773d11ad462f2f1d7aeb4
# Testnet registry: 0xe923e156570961283198faad9e59744b49d1e523
MANDATE_ANCHOR_REGISTRY_ADDRESS=0xc69367d69b12bc14397773d11ad462f2f1d7aeb4

# Local database. Relative paths resolve from the repository root.
# Use this only for local development; the hosted filesystem is ephemeral.
MANDATE_DATABASE_PATH=./data/mandate.db

# Hosted multi-user database. Required on Vercel and any remote deployment.
# Create a database and token with the Turso CLI, then set both values.
# MANDATE_DATABASE_URL=libsql://your-database.turso.io
# MANDATE_DATABASE_AUTH_TOKEN=your-turso-token

# Authentication.
# Local development with a local database defaults to local owner mode when
# GitHub credentials are absent. Hosted deployments always require GitHub OAuth,
# and local auth mode is rejected when the database is remote.
# MANDATE_AUTH_MODE=local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MANDATE_AUTH_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Public origin used for the GitHub callback, for example:
# https://your-app.vercel.app
# GitHub OAuth callback path: /api/auth/github/callback
# MANDATE_PUBLIC_URL=https://your-app.vercel.app

# Seed a clearly-labelled sample workspace for each new account on first use.
# Set to false for a clean ledger.
MANDATE_SEED_DEMO=true

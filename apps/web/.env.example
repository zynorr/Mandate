# Optional overrides. Copy to apps/web/.env.local to change them.
# This build validates that both configured and live chain IDs are 968.
BOT_CHAIN_ID=968
BOT_RPC_URL=https://rpc.bohr.life
BOT_BUNDLER_URL=https://bundler.bohr.life/rpc/
BOT_EXPLORER_URL=https://scan.bohr.life
BOT_EXPLORER_API_URL=https://scan.bohr.life/api/v2
BOT_ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# Optional read-only anchor registry. Remove this line to disable anchor checks.
MANDATE_ANCHOR_REGISTRY_ADDRESS=0xe923e156570961283198faad9e59744b49d1e523

# Relative paths resolve from the repository root in local development.
# When deployed on Vercel without this variable, the app writes to /tmp/mandate.db.
MANDATE_DATABASE_PATH=./data/mandate.db

# Seed a clearly-labelled sample workspace on first run. Set to false for a clean ledger.
MANDATE_SEED_DEMO=true
